<Window x:Class="frontend.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Użytkownik"
        Height="650" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock x:Name="DialogTitle"
                   Text="Nowy użytkownik"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FF6200"
                   Margin="0,0,0,20"/>


        <StackPanel Grid.Row="1" VerticalAlignment="Top">

            <TextBlock Text="Imię" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Nazwisko" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="SurnameBox"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Email" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailBox"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Hasło (zostaw puste aby nie zmieniać)" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         FontSize="14"
                         Padding="10,8"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Margin="0,0,0,14"/>

            <TextBlock Text="Numer telefonu" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="PhoneBox"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Rola" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="RoleComboBox"
                      FontSize="14"
                      Padding="10,8"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1"
                      Margin="0,0,0,14">
                <ComboBoxItem Content="klient" Tag="klient"/>
                <ComboBoxItem Content="kurier" Tag="kurier"/>
                <ComboBoxItem Content="admin" Tag="admin"/>
            </ComboBox>


            <TextBlock x:Name="ErrorText"
                       Text=""
                       Foreground="#D32F2F"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>


        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Anuluj"
                    Width="100"
                    Padding="0,12"
                    Background="#9E9E9E"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="CancelBtn_Click"/>
            <Button x:Name="SaveBtn"
                    Content="Zapisz"
                    Width="120"
                    Padding="0,12"
                    Background="#FF6200"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SaveBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
