<Window x:Class="frontend.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja" Height="700" Width="400"
        WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<Style TargetType="TextBox">
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Margin" Value="0,0,0,15"/>
			<Setter Property="BorderBrush" Value="#DDD"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<Style TargetType="PasswordBox">
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Margin" Value="0,0,0,15"/>
			<Setter Property="BorderBrush" Value="#DDD"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style x:Key="MainButton" TargetType="Button">
			<Setter Property="Background" Value="#FFCC00"/>
			<Setter Property="Foreground" Value="Black"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="0,12"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Window.Resources>

	<Grid Background="#F2F2F2">

		<Border Background="White" Margin="20" CornerRadius="10" Padding="0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Border Background="#FFCC00" Padding="20" CornerRadius="10,10,0,0">
					<TextBlock Text="Utwórz konto"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="Black"
                               HorizontalAlignment="Center"/>
				</Border>
				<StackPanel Grid.Row="1" Margin="25,20">

					<TextBlock Text="Imię"/>
					<TextBox x:Name="NameBox"/>

					<TextBlock Text="Nazwisko"/>
					<TextBox x:Name="SurnameBox"/>

					<TextBlock Text="Email"/>
					<TextBox x:Name="EmailBox"/>

					<TextBlock Text="Hasło"/>
					<PasswordBox x:Name="PasswordBox"/>

					<TextBlock Text="Telefon"/>
					<TextBox x:Name="PhoneBox"/>

					<TextBlock x:Name="ErrorText"
                               Foreground="Red"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               MinHeight="20"/>

					<Button x:Name="RegisterBtn"
                            Content="Utwórz konto"
                            Style="{StaticResource MainButton}"
                            Click="RegisterBtn_Click"/>

				</StackPanel>
				<Border Grid.Row="2"
                        Background="#FAFAFA"
                        Padding="15"
                        CornerRadius="0,0,10,10">

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<TextBlock Text="Masz już konto? " VerticalAlignment="Center"/>
						<Button Content="Zaloguj się"
                                Foreground="Black"
                                Background="Transparent"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="User_Click"/>
					</StackPanel>

				</Border>

			</Grid>
		</Border>

	</Grid>
</Window>