<Window x:Class="frontend.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InPost - Pomoc"
        Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#FFCD00" BorderBrush="#FF6200" BorderThickness="0,0,0,4">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="InPost"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FF6200"
                               Margin="0,0,15,0"/>
                    <TextBlock Text="Pomoc"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        FontSize="18" Foreground="#666" Cursor="Hand"
                        Padding="8,4" Click="Close_Click"/>
            </Grid>
        </Border>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">


                <Border Background="White" CornerRadius="8" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FF6200" Padding="12" CornerRadius="8,8,0,0">
                            <TextBlock Text="Film instruktażowy" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        </Border>


                        <Border Grid.Row="1" Background="Black" MinHeight="350">
                            <Grid>
                                <MediaElement x:Name="HelpVideo"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Stop"
                                              Stretch="Uniform"
                                              MediaEnded="HelpVideo_MediaEnded"/>


                                <StackPanel x:Name="NoVideoOverlay"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Brak pliku wideo" FontSize="16" Foreground="#AAA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Umieść plik help.mp4 w folderze Videos" FontSize="12" Foreground="#777" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>


                        <Border Grid.Row="2" Background="#F5F5F5" Padding="10" CornerRadius="0,0,8,8">
                            <Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button Content="Poprzedni" Click="PrevVideo_Click"
                                            Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                                            Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"
                                            FontSize="12"/>
                                    <TextBlock x:Name="VideoIndexText" Text="Film 1 / 1"
                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#555" Margin="0,0,8,0"/>
                                    <Button Content="Nastepny >" Click="NextVideo_Click"
                                            Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                                            Padding="12,8" BorderThickness="0" Cursor="Hand"
                                            FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Odtworz" Click="Play_Click"
                                            Background="#FF6200" Foreground="White" FontWeight="Bold"
                                            Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"
                                            FontSize="13"/>
                                    <Button Content="Pauza" Click="Pause_Click"
                                            Background="#FFCD00" Foreground="#333" FontWeight="Bold"
                                            Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"
                                            FontSize="13"/>
                                    <Button Content="Stop" Click="Stop_Click"
                                            Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                                            Padding="16,8" BorderThickness="0" Cursor="Hand"
                                            FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>


                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Jak korzystać z aplikacji InPost?"
                                   FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#555" LineHeight="24">
                            <Run FontWeight="Bold" Foreground="#FF6200">Moje paczki</Run>
                            <Run> — przeglądaj swoje przesyłki i sprawdzaj ich status dostawy.</Run>
                            <LineBreak/><LineBreak/>
                            <Run FontWeight="Bold" Foreground="#FF6200">Wyślij paczkę</Run>
                            <Run> — wypełnij formularz z danymi odbiorcy, wybierz rozmiar paczki i paczkomat docelowy z mapy.</Run>
                            <LineBreak/><LineBreak/>
                            <Run FontWeight="Bold" Foreground="#FF6200">Mapa punktów</Run>
                            <Run> — znajdź najbliższy paczkomat na interaktywnej mapie.</Run>
                            <LineBreak/><LineBreak/>
                            <Run FontWeight="Bold" Foreground="#FF6200">Profil</Run>
                            <Run> — kliknij swoje zdjęcie w prawym górnym rogu, aby edytować dane profilu.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
