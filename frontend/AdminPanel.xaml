<Window x:Class="frontend.AdminPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InPost - Panel Administratora" 
        Height="900" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        xmlns:local="clr-namespace:frontend">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFCD00" BorderBrush="#FF6200" BorderThickness="0,0,0,4">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="InPost" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="#FF6200"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="Panel Administratora" 
                               FontSize="28" 
                               FontWeight="SemiBold" 
                               Foreground="#333333"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="48" Height="48" Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="ProfileImageBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Button Content="Wyloguj" 
                            VerticalAlignment="Center"
                            Background="#FF6200"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="20,10"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LogoutBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" Padding="20" Margin="20,20,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFF8E1" Padding="15" Margin="0,0,10,0" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Nieprzypisane" FontSize="12" Foreground="#666666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UnassignedCountText" Text="0" FontSize="32" Foreground="#FF6200" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#E3F2FD" Padding="15" Margin="0,0,10,0" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="W dostawie" FontSize="12" Foreground="#666666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="InTransitCountText" Text="0" FontSize="32" Foreground="#2196F3" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#E8F5E9" Padding="15" Margin="0,0,10,0" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Dostarczone" FontSize="12" Foreground="#666666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeliveredCountText" Text="0" FontSize="32" Foreground="#4CAF50" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#F3E5F5" Padding="15" Margin="0,0,10,0" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Aktywni kurierzy" FontSize="12" Foreground="#666666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActiveKuriersText" Text="0" FontSize="32" Foreground="#9C27B0" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#FCE4EC" Padding="15" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Oczekują na wydanie" FontSize="12" Foreground="#666666" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PendingCountText" Text="0" FontSize="32" Foreground="#E91E63" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="20,0,20,20" BorderThickness="0" Background="Transparent">

            <TabItem Header="Paczki i kurierzy" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FF6200" Padding="15" CornerRadius="8,8,0,0">
                                <Grid>
                                    <TextBlock Text="Wszystkie paczki" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Button Content="Odśwież" HorizontalAlignment="Right" Background="White" Foreground="#FF6200" FontWeight="Bold" Padding="15,8" BorderThickness="0" Cursor="Hand" Click="RefreshBtn_Click"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="PacksDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E0E0E0"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      SelectionChanged="PacksDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding DisplayId}" Width="55"/>
                                    <DataGridTextColumn Header="Rozmiar" Binding="{Binding Size}" Width="65"/>
                                    <DataGridTextColumn Header="Nadawca" Binding="{Binding SenderName}" Width="*"/>
                                    <DataGridTextColumn Header="Odbiorca" Binding="{Binding ReceiverName}" Width="*"/>
                                    <DataGridTextColumn Header="Paczkomat" Binding="{Binding PaczkomatName}" Width="120"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="100"/>
                                    <DataGridTemplateColumn Header="Status" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFF3E0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Nieprzypisana">
                                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Przypisana">
                                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Nieprzypisana">
                                                                        <Setter Property="Foreground" Value="#2196F3"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Przypisana">
                                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Akcje" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Odrzuć"
                                                        Tag="{Binding}"
                                                        Background="#D32F2F"
                                                        Foreground="White"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Padding="10,4"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="RejectAnyPackBtn_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="48"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF8E1"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFE082"/>
                                                <Setter Property="Foreground" Value="#000000"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFCD00" Padding="15" CornerRadius="8,8,0,0">
                                <TextBlock Text="Kurierzy" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                            </Border>

                            <Border Grid.Row="1" Background="#FFF8E1" Padding="15" BorderBrush="#FFE082" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="Wybrana paczka:" FontSize="12" Foreground="#666666" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SelectedPackInfo" Text="Nie wybrano" FontSize="14" Foreground="#333333" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="KuriersListBox" Grid.Row="2" BorderThickness="0" SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Email}" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Background="#E3F2FD" CornerRadius="3" Padding="6,2">
                                                        <TextBlock FontSize="10" Foreground="#2196F3" FontWeight="SemiBold">
                                                            <Run Text="Paczek: "/>
                                                            <Run Text="{Binding AssignedPacksCount}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3" Margin="15">
                                <Button Content="Przypisz kuriera" Background="#FF6200" Foreground="White" FontSize="14" FontWeight="Bold" Padding="0,15" BorderThickness="0" Cursor="Hand" Click="AssignBtn_Click" Margin="0,0,0,8"/>
                                <Button Content="Wydaj oczekującą" Background="#E91E63" Foreground="White" FontSize="13" FontWeight="Bold" Padding="0,12" BorderThickness="0" Cursor="Hand" Click="ReleasePackBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Użytkownicy" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <Border Background="White" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#3F51B5" Padding="15" CornerRadius="8,8,0,0">
                            <Grid>
                                <TextBlock Text="Zarządzanie użytkownikami" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RefreshUsersBtn"
                                            Content="Odśwież"
                                            Background="White"
                                            Foreground="#3F51B5"
                                            FontWeight="Bold"
                                            Padding="15,8"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,10,0"
                                            Click="RefreshUsersBtn_Click"/>
                                    <Button x:Name="AddUserBtn"
                                            Content="+ Dodaj użytkownika"
                                            Background="#FFCD00"
                                            Foreground="#333333"
                                            FontWeight="Bold"
                                            Padding="15,8"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="AddUserBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#F5F5F5" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Filtruj rolę:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="#555555"/>
                                <ComboBox x:Name="RoleFilterComboBox"
                                          Width="150"
                                          FontSize="13"
                                          Padding="8,5"
                                          SelectionChanged="RoleFilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Wszyscy" IsSelected="True"/>
                                    <ComboBoxItem Content="klient"/>
                                    <ComboBoxItem Content="kurier"/>
                                    <ComboBoxItem Content="admin"/>
                                </ComboBox>
                                <TextBlock x:Name="UserCountText" Text="" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#888888" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="UsersDataGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E0E0E0"
                                  BorderThickness="0"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Imię" Binding="{Binding Name}" Width="120"/>
                                <DataGridTextColumn Header="Nazwisko" Binding="{Binding Surname}" Width="150"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="Telefon" Binding="{Binding PhoneNumber}" Width="120"/>
                                <DataGridTemplateColumn Header="Rola" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="admin">
                                                                <Setter Property="Background" Value="#FCE4EC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Role}" Value="kurier">
                                                                <Setter Property="Background" Value="#F3E5F5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#2196F3"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="admin">
                                                                    <Setter Property="Foreground" Value="#E91E63"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="kurier">
                                                                    <Setter Property="Foreground" Value="#9C27B0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Akcje" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,2">
                                                <Button Content="Edytuj"
                                                        Tag="{Binding}"
                                                        Background="#FF6200"
                                                        Foreground="White"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Padding="12,5"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Margin="0,0,6,0"
                                                        Click="EditUserBtn_Click"/>
                                                <Button Content="Usuń"
                                                        Tag="{Binding}"
                                                        Background="#D32F2F"
                                                        Foreground="White"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Padding="12,5"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="DeleteUserBtn_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="48"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8EAF6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#C5CAE9"/>
                                            <Setter Property="Foreground" Value="#000000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>


            <TabItem Header="Dostarczone paczki" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <Border Background="White" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#4CAF50" Padding="15" CornerRadius="8,8,0,0">
                            <Grid>
                                <TextBlock Text="Wszystkie dostarczone paczki" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Content="Odśwież" HorizontalAlignment="Right"
                                        Background="White" Foreground="#4CAF50" FontWeight="Bold"
                                        Padding="15,8" BorderThickness="0" Cursor="Hand"
                                        Click="RefreshDeliveredBtn_Click"/>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="DeliveredPacksDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E0E0E0"
                                  BorderThickness="0"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding PackId}" Width="60"/>
                                <DataGridTextColumn Header="Rozmiar" Binding="{Binding Size}" Width="80"/>
                                <DataGridTextColumn Header="Paczkomat" Binding="{Binding KlientName}" Width="*"/>
                                <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="120"/>
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PickedUp}" Value="True">
                                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Doręczona"/>
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PickedUp}" Value="True">
                                                                    <Setter Property="Text" Value="Odebrana"/>
                                                                    <Setter Property="Foreground" Value="#2196F3"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="48"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#C8E6C9"/>
                                            <Setter Property="Foreground" Value="#000000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
