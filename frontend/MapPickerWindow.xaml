<Window x:Class="frontend.MapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Wybierz punkt InPost" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" AllowsTransparency="False"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Grid.Row="0" Background="#FFCD00" BorderBrush="#FF6200" BorderThickness="0,0,0,4" Padding="15,10">
            <TextBlock Text="Wybierz paczkomat z mapy" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
        </Border>

        <wv2:WebView2 x:Name="MapWebView" Grid.Row="1" Margin="5"/>

        <Border Grid.Row="2" Background="White" Padding="12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SelectedInfo" Text="Nie wybrano punktu"
                           VerticalAlignment="Center" Margin="0,0,15,0"
                           FontWeight="SemiBold" Foreground="#666"/>
                <Button Content="Zatwierdź" Width="120" Height="35"
                        Click="Confirm_Click"
                        Background="#FF6200" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>
                <Button Content="Anuluj" Width="90" Height="35" Margin="10,0,0,0"
                        Click="Cancel_Click"
                        Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
