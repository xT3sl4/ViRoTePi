<Window x:Class="frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:local="clr-namespace:frontend"
        Title="InPost Desktop" Height="700" Width="1200"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:DeliveredToVisibilityConverter x:Key="DeliveredToVisibilityConverter"/>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFCD00"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FF6200"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E55A00"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FFCD00" BorderBrush="#FF6200" BorderThickness="0,0,0,4">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="InPost"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#FF6200"
                                   Margin="0,0,20,0"/>
                        <TextBlock Text="Panel Klienta"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                        <Button BorderBrush="Transparent" Background="Transparent"
                                Padding="0" Margin="0,0,12,0"
                                Click="User_Click" ToolTip="Edytuj profil"
                                Cursor="Hand">
                            <Ellipse x:Name="SelfieEllipse" Width="48" Height="48">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="ProfileImageBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Button>

                        <StackPanel x:Name="LoggedInPanel" Visibility="Collapsed"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText"
                                       Text=""
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       Margin="0,0,0,4"/>
                            <Button x:Name="LogoutBtn"
                                    Content="Wyloguj"
                                    Click="LogoutBtn_Click"
                                    Background="#FF6200"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="11"
                                    Padding="12,5"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>


                        <Button x:Name="LoginBtn"
                                Content="Zaloguj się"
                                Visibility="Collapsed"
                                Click="User_Click"
                                Background="White"
                                Foreground="#FF6200"
                                FontWeight="Bold"
                                FontSize="12"
                                Padding="16,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>


            <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5">
                <StackPanel Margin="10,15,10,10">
                    <Button Content="Moje paczki" Height="50" Margin="0,4"
                            Click="Packages_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Historia" Height="50" Margin="0,4"
                            Click="History_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Wyślij paczkę" Height="50" Margin="0,4"
                            Click="SendPackage_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Wyślij do klienta" Height="50" Margin="0,4"
                            Click="SendToClient_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Mapa punktów" Height="50" Margin="0,4"
                            Click="MapButton_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Pomoc" Height="50" Margin="0,4"
                            Click="Help_Click" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>
            </Border>


            <Grid Grid.Row="1" Grid.Column="1">
                <Grid x:Name="PackagesPanel" Visibility="Visible" Margin="10">
                    <Border Background="White" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FF6200" Padding="15" CornerRadius="8,8,0,0">
                                <Grid>
                                    <TextBlock Text="Twoje Paczki" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Button Content="Odśwież" HorizontalAlignment="Right"
                                            Background="White" Foreground="#FF6200" FontWeight="Bold"
                                            Padding="15,8" BorderThickness="0" Cursor="Hand"
                                            Click="Packages_Click"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="PacksDataGrid" Grid.Row="1"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      CanUserDeleteRows="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E0E0E0"
                                      BorderThickness="0"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Numer paczki" Binding="{Binding PackId}" Width="80"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Delivered}" Width="*"/>
                                    <DataGridTextColumn Header="Paczkomat" Binding="{Binding KlientName}" Width="*"/>
                                    <DataGridTextColumn Header="Rozmiar" Binding="{Binding Size}" Width="70"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="100"/>
                                    <DataGridTemplateColumn Header="Akcja" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Odbierz"
                                                        Tag="{Binding}"
                                                        Click="PickupPack_Click"
                                                        Background="#FF6200"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        FontSize="11"
                                                        Padding="10,4"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Visibility="{Binding Delivered, Converter={StaticResource DeliveredToVisibilityConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="50"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF8E1"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFE082"/>
                                                <Setter Property="Foreground" Value="#000000"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SendPackagePanel" Visibility="Collapsed" Margin="10">
                    <Border Background="White" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFCD00" Padding="15" CornerRadius="8,8,0,0">
                                <TextBlock Text="Wyślij paczkę" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                            </Border>

                            <Border Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="20">
                                <TextBlock Text="Imię" FontWeight="SemiBold" FontSize="14" Foreground="#555" Margin="0,0,0,5"/>
                                <TextBox x:Name="Firstname_TextBox" Margin="0,0,0,10" Padding="10,8" FontSize="14" BorderBrush="#E0E0E0"/>
                                <TextBlock Text="Nazwisko" FontWeight="SemiBold" FontSize="14" Foreground="#555" Margin="0,0,0,5"/>
                                <TextBox x:Name="Surname_TextBox" Margin="0,0,0,10" Padding="10,8" FontSize="14" BorderBrush="#E0E0E0"/>
                                <TextBlock Text="Email odbiorcy" FontWeight="SemiBold" FontSize="14" Foreground="#555" Margin="0,0,0,5"/>
                                <TextBox x:Name="EmailAdres_TextBox" Margin="0,0,0,10" Padding="10,8" FontSize="14" BorderBrush="#E0E0E0"/>
                                <TextBlock Text="Numer telefonu odbiorcy" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="PhoneSlider" Minimum="500000000" Maximum="899999999"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Width="590"
                                            KeyDown="PhoneSlider_KeyDown" ValueChanged="PhoneSlider_ValueChanged"/>
                                    <TextBlock x:Name="PhoneValueText" Text="500 000 000" FontSize="18"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Rozmiar paczki" FontWeight="Bold" FontSize="16" Margin="0,10,0,10"/>
                                <ListBox x:Name="parcel_size_ListBox" Height="230" Background="Transparent" BorderThickness="0">
                                    <ListBox.Resources>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,0,12"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="border" Background="White" CornerRadius="12"
                                                                Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#FFFDEB3B"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#FBC02D"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#FFF9D835"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#F9A825"/>
                                                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBoxItem x:Name="small_parcel" Selected="small_parcel_Selected">
                                        <StackPanel>
                                            <TextBlock Text="S — MAŁA" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="8 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                            <TextBlock Text="14,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem x:Name="medium_parcel" Selected="medium_parcel_Selected">
                                        <StackPanel>
                                            <TextBlock Text="M — ŚREDNIA" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="19 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                            <TextBlock Text="16,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem x:Name="big_parcel" Selected="big_parcel_Selected">
                                        <StackPanel>
                                            <TextBlock Text="L — DUŻA" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="41 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                            <TextBlock Text="19,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>
                                <TextBlock x:Name="price_to_pay" Text="" Foreground="Gray" FontStyle="Italic"/>
                                <Button Content="Wybierz Paczkomat z Mapy" Click="LockerButton_Click"
                                        Background="#FF6200" Foreground="White" FontWeight="Bold"
                                        Height="40" Margin="0,10" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock x:Name="SelectedLockerInfo" Text="Nie wybrano paczkomatu"
                                           Foreground="Gray" FontStyle="Italic"/>
                                <Button Content="Wyślij" Click="SendButton_Click"
                                        Background="#FF6200" Foreground="White" FontWeight="Bold"
                                        Height="40" Margin="0,10" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>


                <Grid x:Name="HistoryPanel" Visibility="Collapsed" Margin="10">
                    <Border Background="White" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FF6200" Padding="15" CornerRadius="8,8,0,0">
                                <Grid>
                                    <TextBlock Text="Historia paczek" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Button Content="Odśwież" HorizontalAlignment="Right"
                                            Background="White" Foreground="#FF6200" FontWeight="Bold"
                                            Padding="15,8" BorderThickness="0" Cursor="Hand"
                                            Click="History_Click"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="HistoryDataGrid" Grid.Row="1"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      CanUserDeleteRows="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E0E0E0"
                                      BorderThickness="0"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Numer paczki" Binding="{Binding PackId}" Width="80"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Delivered}" Width="*"/>
                                    <DataGridTextColumn Header="Paczkomat" Binding="{Binding KlientName}" Width="*"/>
                                    <DataGridTextColumn Header="Rozmiar" Binding="{Binding Size}" Width="70"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="100"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="50"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF8E1"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFE082"/>
                                                <Setter Property="Foreground" Value="#000000"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>


                <Grid x:Name="SendToClientPanel" Visibility="Collapsed" Margin="10">
                    <Border Background="White" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFCD00" Padding="15" CornerRadius="8,8,0,0">
                                <TextBlock Text="Wyślij do klienta" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                            </Border>

                            <Border Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="20">
                                        <TextBlock Text="Wybierz odbiorcę:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <ListBox x:Name="ClientsListBox" Height="250" Background="Transparent" BorderThickness="0"
                                                 SelectionChanged="ClientsListBox_SelectionChanged">
                                            <ListBox.Resources>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="border" Background="White" CornerRadius="12"
                                                                        Padding="12" BorderBrush="#E0E0E0" BorderThickness="1">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#FFFDEB3B"/>
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#FBC02D"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#FFF9D835"/>
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#F9A825"/>
                                                                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.Resources>
                                        </ListBox>

                                        <TextBlock x:Name="SelectedClientInfo" Text="Nie wybrano odbiorcy"
                                                   Foreground="Gray" FontStyle="Italic" Margin="0,10,0,0"/>

                                        <TextBlock Text="Rozmiar paczki" FontWeight="Bold" FontSize="16" Margin="0,15,0,10"/>
                                        <ListBox x:Name="ClientParcelSizeListBox" Height="230" Background="Transparent" BorderThickness="0">
                                            <ListBox.Resources>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Margin" Value="0,0,0,12"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="border" Background="White" CornerRadius="12"
                                                                        Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#FFFDEB3B"/>
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#FBC02D"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#FFF9D835"/>
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#F9A825"/>
                                                                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.Resources>
                                            <ListBoxItem x:Name="client_small_parcel" Selected="client_small_parcel_Selected">
                                                <StackPanel>
                                                    <TextBlock Text="S — MAŁA" FontSize="17" FontWeight="Bold"/>
                                                    <TextBlock Text="8 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                                    <TextBlock Text="14,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem x:Name="client_medium_parcel" Selected="client_medium_parcel_Selected">
                                                <StackPanel>
                                                    <TextBlock Text="M — ŚREDNIA" FontSize="17" FontWeight="Bold"/>
                                                    <TextBlock Text="19 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                                    <TextBlock Text="16,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </ListBoxItem>
                                            <ListBoxItem x:Name="client_big_parcel" Selected="client_big_parcel_Selected">
                                                <StackPanel>
                                                    <TextBlock Text="L — DUŻA" FontSize="17" FontWeight="Bold"/>
                                                    <TextBlock Text="41 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                                    <TextBlock Text="19,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </ListBoxItem>
                                        </ListBox>

                                        <TextBlock x:Name="ClientPriceText" Text="" Foreground="Gray" FontStyle="Italic"/>

                                        <Button Content="Wybierz Paczkomat z Mapy" Click="ClientLockerButton_Click"
                                                Background="#FF6200" Foreground="White" FontWeight="Bold"
                                                Height="40" Margin="0,10" BorderThickness="0" Cursor="Hand"/>
                                        <TextBlock x:Name="ClientSelectedLockerInfo" Text="Nie wybrano paczkomatu"
                                                   Foreground="Gray" FontStyle="Italic"/>

                                        <Button Content="Wyślij do klienta" Click="SendToClientButton_Click"
                                                Background="#FF6200" Foreground="White" FontWeight="Bold"
                                                Height="40" Margin="0,10" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
