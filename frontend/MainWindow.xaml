<Window x:Class="frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="InPost Desktop" Height="700" Width="1200">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                <Grid Height="120">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="Images/inpost_logo.png" Height="100" Grid.Column="0" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <Button BorderBrush="Transparent" Background="Transparent" Height="64" Grid.Column="2" HorizontalAlignment="Right" x:Name="User" Click="User_Click">
                        <Image Source="Images/user.png" Height="64"/>
                    </Button>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="0">
                <StackPanel Margin="10">
                    <Button Content="Moje paczki" Height="60" FontSize="18" Margin="0,5" Click="Packages_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Wyślij paczkę" Height="60" FontSize="18" Margin="0,5" Click="SendPackage_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Mapa punktów" Height="60" FontSize="18" Margin="0,5" Click="MapButton_Click" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Pomoc" Height="60" FontSize="18" Margin="0,5" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1">
                <StackPanel x:Name="PackagesPanel" Visibility="Visible" Margin="10">
                    <TextBlock Text="Twoje Paczki" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Width="770" Height="450" Background="White" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Direction="-90" ShadowDepth="2" Color="Black" Opacity="0.2"/>
                        </Border.Effect>
                        <DataGrid x:Name="PacksDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Numer paczki" Binding="{Binding PackId}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Delivered}" Width="*"/>
                                <DataGridTextColumn Header="Nazwa paczkomatu" Binding="{Binding KlientName}" Width="*"/>
                                <DataGridTextColumn Header="Rozmiar" Binding="{Binding Size}" Width="*"/>
                                <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="SendPackagePanel" Visibility="Collapsed" Margin="10">
                    <TextBlock Text="Wyślij paczkę" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Width="770" Height="450" Background="White" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="Black" Opacity="0.2"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="Imię" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <TextBox x:Name="Firstname_TextBox" Margin="0,5"/>
                                <TextBlock Text="Nazwisko" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <TextBox x:Name="Surname_TextBox" Margin="0,5"/>
                                <TextBlock Text="Email odbiorcy" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <TextBox x:Name="EmailAdres_TextBox" Margin="0,5"/>
                                <TextBlock Text="Numer telefonu odbiorcy" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="PhoneSlider" Minimum="500000000" Maximum="899999999" TickFrequency="1" IsSnapToTickEnabled="True" Width="590" KeyDown="PhoneSlider_KeyDown" ValueChanged="PhoneSlider_ValueChanged"/>
                                    <TextBlock x:Name="PhoneValueText" Text="500 000 000" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Rozmiar paczki" FontWeight="Bold" FontSize="16" Margin="0,10,0,10"/>
                                <ListBox x:Name="parcel_size_ListBox" Height="230" Background="Transparent" BorderThickness="0">
                                    <ListBox.Resources>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,0,12"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="border" Background="White" CornerRadius="12" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#FFFDEB3B"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#FBC02D"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#FFF9D835"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#F9A825"/>
                                                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBoxItem x:Name="small_parcel" Selected="small_parcel_Selected">
                                        <StackPanel>
                                            <TextBlock Text="S — MAŁA" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="8 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                            <TextBlock Text="14,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem x:Name="medium_parcel" Selected="medium_parcel_Selected">
                                        <StackPanel>
                                            <TextBlock Text="M — ŚREDNIA" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="19 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                            <TextBlock Text="16,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem x:Name="big_parcel" Selected="big_parcel_Selected">
                                        <StackPanel>
                                            <TextBlock Text="L — DUŻA" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="41 × 38 × 64 cm" FontSize="13" Foreground="Gray" Margin="0,2,0,0"/>
                                            <TextBlock Text="19,99 zł" FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>
                                <TextBlock x:Name="price_to_pay" Text="" Foreground="Gray" FontStyle="Italic"/>
                                <Button Content="Wybierz Paczkomat z Mapy" Click="LockerButton_Click" Background="#FAD02A" Height="40" Margin="0,10"/>
                                <TextBlock x:Name="SelectedLockerInfo" Text="Nie wybrano paczkomatu" Foreground="Gray" FontStyle="Italic"/>
                                <Button Content="Wyślij" Click="SendButton_Click" Background="#FAD02A" Height="40" Margin="0,10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                </Grid>
           </Grid>
    </Grid>
</Window>