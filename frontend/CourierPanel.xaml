<Window x:Class="frontend.CourierPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InPost - Panel Kuriera" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFCD00" BorderBrush="#FF6200" BorderThickness="0,0,0,4">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="InPost"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FF6200"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="Panel Kuriera"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="StatusBorder" Background="#4CAF50" CornerRadius="14" Padding="12,6" Margin="0,0,15,0"
                            Cursor="Hand" MouseLeftButtonUp="StatusToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Dostępny" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Ellipse Width="48" Height="48" Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="ProfileImageBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Button Content="Wyloguj"
                            VerticalAlignment="Center"
                            Background="#FF6200"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="20,10"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LogoutBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>


        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="ListViewBtn" Content="Lista paczek"
                        Background="#FF6200" Foreground="White" FontWeight="Bold"
                        FontSize="14" Padding="20,10" BorderThickness="0" Cursor="Hand"
                        Margin="0,0,10,0" Click="ListViewBtn_Click"/>
                <Button x:Name="MapViewBtn" Content="Mapa paczek"
                        Background="#FFCD00" Foreground="#333333" FontWeight="Bold"
                        FontSize="14" Padding="20,10" BorderThickness="0" Cursor="Hand"
                        Click="MapViewBtn_Click"/>
            </StackPanel>

            <Border x:Name="ListViewPanel" Grid.Row="1" Background="White" CornerRadius="8" Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF6200" Padding="15" CornerRadius="8,8,0,0">
                        <Grid>
                            <TextBlock Text="Paczki do wydania" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="Odśwież" HorizontalAlignment="Right"
                                    Background="White" Foreground="#FF6200" FontWeight="Bold"
                                    Padding="15,8" BorderThickness="0" Cursor="Hand"
                                    Click="RefreshParcels_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#FFF8E1" Padding="10,10" BorderBrush="#FFE082" BorderThickness="0,0,0,1">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Numer paczki" FontWeight="Bold" FontSize="13" Foreground="#666666"/>
                            <TextBlock Text="Paczkomat" FontWeight="Bold" FontSize="13" Foreground="#666666" Grid.Column="1"/>
                            <TextBlock Text="Akcja" FontWeight="Bold" FontSize="13" Foreground="#666666" Grid.Column="2" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PackagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFF8E1"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OrderNumber}" FontSize="14" VerticalAlignment="Center" Foreground="#333333"/>
                                            <TextBlock Text="{Binding LockerCode}" FontSize="14" FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center" Foreground="#333333"/>
                                            <Button Grid.Column="2" Content="Wydaj paczkę"
                                                    Background="#FF6200"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    FontSize="12"
                                                    Padding="12,8"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="DeliverButton_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="MapViewPanel" Grid.Row="1" Background="White" CornerRadius="8" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF6200" Padding="15" CornerRadius="8,8,0,0">
                        <TextBlock Text="Mapa paczek do dostarczenia" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <Border Grid.Row="1" x:Name="MapContainer">
                        <TextBlock x:Name="MapPlaceholder"
                                   Text="Ładowanie mapy..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="#999"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
