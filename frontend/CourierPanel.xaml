<Window x:Class="frontend.CourierPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Kuriera" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FAD02A"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE">
            <Grid Margin="20,0">
                <TextBlock Text="INPOST KURIER" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#FAD02A"/>
                <Button Content="Wyloguj" HorizontalAlignment="Right" Width="100" Height="35" Style="{StaticResource MenuButtonStyle}" Click="LogoutBtn_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="40">
            <TextBlock Text="Paczki do wydania" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Grid Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Numer paczki" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Text="Paczkomat" FontWeight="Bold" Foreground="Gray" Grid.Column="1"/>
                    </Grid>
                    <Separator Margin="0,10"/>

                    <ItemsControl x:Name="PackagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OrderNumber}" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LockerCode}" FontSize="16" FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Wydaj paczkę" 
                                            Background="#FAD02A" FontWeight="Bold" Padding="8,5"
                                            Click="DeliverButton_Click" 
                                            Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>