<Window x:Class="frontend.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytuj profil"
        Height="600" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>

        <Border VerticalAlignment="Top" Height="80" Background="#FFCD00">
            <StackPanel VerticalAlignment="Center" Margin="30,0">
                <TextBlock Text="Edytuj profil" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock Text="Zmień swoje dane osobowe" FontSize="12" Foreground="#555555" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>


        <ScrollViewer Margin="0,80,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20,30,30">

                <TextBlock Text="Imię" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox"
                         FontSize="14"
                         Padding="10,8"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Background="White"
                         Margin="0,0,0,14"/>


                <TextBlock Text="Nazwisko" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="SurnameBox"
                         FontSize="14"
                         Padding="10,8"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Background="White"
                         Margin="0,0,0,14"/>


                <TextBlock Text="Adres e-mail" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailBox"
                         FontSize="14"
                         Padding="10,8"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Background="White"
                         Margin="0,0,0,14"/>


                <TextBlock Text="Numer telefonu" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="PhoneBox"
                         FontSize="14"
                         Padding="10,8"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Background="White"
                         Margin="0,0,0,14"/>


                <TextBlock Text="Nowe hasło" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"
                             FontSize="14"
                             Padding="10,8"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"
                             Background="White"
                             Margin="0,0,0,4"/>
                <TextBlock Text="Zostaw puste, jeśli nie chcesz zmieniać hasła"
                           FontSize="11" Foreground="#999999" Margin="0,0,0,14"/>


                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#D32F2F"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

 
                <TextBlock x:Name="SuccessText"
                           Text=""
                           Foreground="#2E7D32"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Anuluj"
                            Padding="0,12"
                            Background="#9E9E9E"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelBtn_Click"/>

                    <Button Grid.Column="2"
                            x:Name="SaveBtn"
                            Content="Zapisz zmiany"
                            Padding="0,12"
                            Background="#FF6200"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SaveBtn_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
