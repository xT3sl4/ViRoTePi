<Window x:Class="frontend.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Wybierz punkt InPost" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" AllowsTransparency="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <wv2:WebView2 x:Name="MapWebView" Grid.Row="0" Margin="5"/>

        <Border Grid.Row="1" Background="#F0F0F0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SelectedInfo" Text="Nie wybrano punktu" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold"/>
                <Button Content="Zatwierdź" Width="100" Height="30" Click="Confirm_Click" Background="#fad02a" BorderBrush="Transparent"/>
                <Button Content="Anuluj" Width="80" Height="30" Margin="10,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
